{
  "name": "@ai0/agent-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "development": "./src/kernel/index.ts",
      "types": "./dist/kernel/index.d.ts",
      "default": "./dist/kernel/index.js"
    },
    "./subsystems": {
      "development": "./src/subsystems/index.ts",
      "types": "./dist/subsystems/index.d.ts",
      "default": "./dist/subsystems/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai0/protocol": "workspace:*",
    "@ai0/extension-core": "workspace:*",
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/deepseek": "3.0.89",
    "@ai-sdk/openai-compatible": "3.0.94",
    "ai": "7.0.179"

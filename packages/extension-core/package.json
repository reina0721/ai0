{
  "name": "@ai0/extension-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "development": "./src/kernel/index.ts",
      "types": "./dist/kernel/index.d.ts",
      "default": "./dist/kernel/index.js"
    },
    "./subsystems": {
      "development": "./src/subsystems/index.ts",
      "types": "./dist/subsystems/index.d.ts",
      "default": "./dist/subsystems/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai0/protocol": "workspace:*",
    "@deepseek-ai/cordis": "4.1.0"
  }
}

{
  "$schema": "https://ai0.dev/schemas/ai0.extension.schema.json",
  "manifest_version": "1.1.0",
  "extension_id": "builtin.webchat",
  "display_name": "Built-in WebChat Shell",
  "version": "1.0.0",
  "author": "ai0-official",
  "carrier_kind": "native_code_plugin",
  "extension_bus": "ext.shell",
  "dimension": "ext.shell",
  "entry_point": "./dist/index.js",
  "entry": "./dist/index.js",
  "permissions": {
    "read_blackboard_domains": ["D1_WORKING_TURN", "D2_HOMEOSTASIS_AFFECT"],
    "propose_mutation_domains": [],
    "max_audience_scope": "only_owner",
    "network_access": false
  },
  "console_contributions": {
    "ui_slots": [
      {
        "slot_target": "slot.shells.mounted_stage",
        "widget_type": "sandboxed_iframe_stage",
        "title": "WebChat",
        "route_path": "/shells/stage/builtin.webchat"
      }
    ]
  }
}

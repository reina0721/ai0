{
  "manifest_version": "2.0.0",
  "extension_id": "builtin.lorebook-contributor",
  "display_name": "设定集贡献器",
  "version": "1.0.0",
  "author": "ai0-official",
  "carrier_kind": "native_code_plugin",
  "facets": [
    "cognition.context_contributor",
    "console.config_schema"
  ],
  "entry": "./dist/index.js",
  "permissions": {
    "read_blackboard_domains": [
      "D1_WORKING_TURN",
      "D3_MEMORY_PROJECTION",
      "D5_IDENTITY_NARRATIVE"
    ],
    "propose_mutation_domains": [],
    "max_audience_scope": "public_all",
    "network_access": false
  },
  "console_contributions": {
    "config_fields": [
      {
        "key": "max_recursive_depth",
        "label": "递归匹配层数",
        "type": "int",
        "default": 3,
        "min": 1
      },
      {
        "key": "default_token_budget",
        "label": "默认 Token 预算",
        "type": "int",
        "default": 240,
        "min": 0
      }
    ]
  }
}

{
  "manifest_version": "2.0.0",
  "extension_id": "builtin.web-tools",
  "display_name": "安全联网检索与抓取工具箱",
  "description": "面向通用智能体的防 SSRF 只读网页检索与抓取工具包（web.search + web.fetch_url），所有外部响应强制标记为 untrusted_external 污点以联动同轮写/执行熔断。",
  "version": "1.1.0",
  "author": "ai0-official",
  "carrier_kind": "native_code_plugin",
  "default_enabled": false,
  "facets": [
    "agent.tool_provider",
    "console.config_schema"
  ],
  "entry": "./dist/index.js",
  "permissions": {
    "read_blackboard_domains": [],
    "propose_mutation_domains": [],
    "max_audience_scope": "only_owner",
    "network_access": true
  },
  "console_contributions": {
    "config_fields": [
      {
        "key": "search_provider",
        "label": "搜索引擎提供方",
        "type": "select",
        "default": "duckduckgo_html",
        "options": [
          { "value": "duckduckgo_html", "label": "DuckDuckGo Lite（免 Key 默认）" },
          { "value": "searxng", "label": "SearXNG JSON API" },
          { "value": "tavily", "label": "Tavily Search API" },
          { "value": "brave", "label": "Brave Search API" }
        ]
      },
      {
        "key": "search_endpoint_url",
        "label": "自定义检索端点 URL（用于 SearXNG 等）",
        "type": "string",
        "default": ""
      },
      {
        "key": "search_api_key",
        "label": "检索服务 API Key（Tavily / Brave 可选）",
        "type": "secret",
        "default": ""
      },
      {
        "key": "allow_local_searxng",
        "label": "允许连接本机自托管 SearXNG 端点",
        "type": "bool",
        "default": false
      },
      {
        "key": "max_response_bytes",
        "label": "单次网页最大读取字节数",
        "type": "int",
        "default": 65536,
        "min": 1024,
        "max": 524288
      },
      {
        "key": "request_timeout_ms",
        "label": "请求超时上限（ms）",
        "type": "int",
        "default": 12000,
        "min": 500,
        "max": 60000
      }
    ]
  }
}

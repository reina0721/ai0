# ==============================================================================
# ai0 — Universal Cyber-Life Cognitive Kernel Environment Configuration
# Copy this file to `.env` to customize your local sovereign runtime.
# ==============================================================================

# Unified Daemon + WebUI Console HTTP Port (Channel A + Channel B + Console UI)
AI0_PORT=4173
AI0_HOST=127.0.0.1

# Path to the active local-first `.soul` archive directory
AI0_SOUL_DIR=./souls/default.soul

# Target instance sovereignty mode: "live" (1x real clock, 403 time-warp fence) or "sandbox:<id>"
AI0_TARGET_INSTANCE=live

# Owner Master Session Token for Channel B Privileged Admin API (/api/admin/v1/*)
# Leave unset in local dev to use the auto-provisioned session token printed at startup.
AI0_OWNER_TOKEN=ai0-local-owner-dev-token

# ------------------------------------------------------------------------------
# Optional External LLM Provider Configuration (OpenAI / Anthropic / Gemini / Ollama)
# When AI0_LLM_API_KEY is omitted, ai0 uses its built-in Context-Aware Persona
# Synthesizer grounded in the compiled <2500-token Cognitive Blackboard & SQLite memory.
# ------------------------------------------------------------------------------
AI0_LLM_PROVIDER=openai-compatible
AI0_LLM_BASE_URL=https://api.openai.com/v1
AI0_LLM_API_KEY=
AI0_LLM_MODEL=gpt-4o-mini
